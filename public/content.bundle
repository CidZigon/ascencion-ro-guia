<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AscencionRO · Enciclopedia Pre-Renewal</title>
<style>
:root{--bg:#06111b;--panel:#0d2131;--panel2:#132e43;--line:#29495f;--text:#eef7ff;--muted:#a9bfce;--gold:#f1c95e;--mint:#65d7c7;--shadow:0 18px 55px #0008}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 80% -10%,#173950 0,transparent 34rem),linear-gradient(#06111b,#091926 58%,#06111b);color:var(--text);font:14px/1.48 system-ui,-apple-system,Segoe UI,sans-serif}
button,input{font:inherit}.layout{display:grid;grid-template-columns:244px minmax(0,1fr);min-height:100vh}
.sidebar{position:sticky;top:0;height:100vh;background:#071521f2;border-right:1px solid var(--line);padding:14px 11px;display:flex;flex-direction:column;z-index:50}
.brand{padding:7px 9px 14px;border-bottom:1px solid var(--line);margin-bottom:10px}.brand .eyebrow{color:var(--mint);font-size:.67rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.brand h1{font-size:1.25rem;line-height:1.05;color:#fff0b7;margin:6px 0}.brand p{font-size:.74rem;color:var(--muted);margin:0}
.home{width:100%;padding:10px;text-align:left;border:1px solid #3d6a60;border-radius:11px;background:#11342f;color:#e0fff8;font-weight:900;cursor:pointer;margin-bottom:7px}
.module-nav{display:grid;gap:6px;overflow:auto}.module-tab{display:grid;grid-template-columns:27px 32px 1fr;align-items:center;gap:5px;text-align:left;padding:8px;background:#0c1f2e;color:var(--text);border:1px solid var(--line);border-radius:11px;cursor:pointer}
.module-tab:hover{border-color:#4f7d83}.module-tab.active{background:#153849;border-color:#63aa9e;box-shadow:inset 3px 0 var(--mint)}.module-tab span{font-size:1.1rem}.module-tab b{color:var(--gold)}.module-tab small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#bed1dd}
.sidefoot{margin-top:auto;border-top:1px solid var(--line);padding:10px 8px 0;color:var(--muted);font-size:.68rem}
.content{min-width:0}.topbar{position:sticky;top:0;z-index:45;display:flex;align-items:center;gap:8px;padding:9px 13px;background:#071521f0;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.current{font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:340px}.searchbox{margin-left:auto;display:flex;gap:7px;width:min(680px,60vw)}#globalSearch{width:100%;background:#0c2030;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:9px 11px}.topbar button{background:#10283a;border:1px solid var(--line);color:var(--text);border-radius:9px;padding:8px 9px;cursor:pointer;font-weight:850}
#homeView{max-width:1280px;margin:auto;padding:34px 24px 55px}.hero{padding:18px 0 27px}.hero .eyebrow{color:var(--mint);font-size:.72rem;font-weight:950;letter-spacing:.14em;text-transform:uppercase}.hero h2{font-size:clamp(2.3rem,5vw,4.7rem);line-height:.98;margin:.18em 0}.hero h2 span{color:var(--gold)}.hero p{max-width:860px;color:#c2d4df;font-size:1.04rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}.module-card{text-align:left;color:var(--text);background:linear-gradient(#143148,#0d2131);border:1px solid var(--line);border-radius:18px;padding:15px;min-height:230px;cursor:pointer;transition:.17s}.module-card:hover{transform:translateY(-3px);border-color:#4d7b83;box-shadow:var(--shadow)}.mc-top{display:flex;justify-content:space-between}.mc-top span{color:var(--gold);font-size:.72rem;font-weight:950;letter-spacing:.08em}.mc-top em{font-style:normal;font-size:.67rem;border:1px solid #3a674d;color:#c5efd0;border-radius:999px;padding:3px 6px}.mc-icon{font-size:2rem;margin-top:20px}.module-card h2{color:#fff0b8;font-size:1.2rem;margin:6px 0}.module-card p{color:#bdd0dc;min-height:64px}.module-card strong{color:#98e9dc;font-size:.78rem}
#moduleView{display:none;min-height:calc(100vh - 50px)}#moduleHost{display:block;min-height:100%;background:#07111b}
.search-panel{display:none;position:fixed;top:51px;right:14px;width:min(850px,calc(100vw - 285px));max-height:78vh;overflow:auto;background:#081a27;border:1px solid var(--line);border-radius:14px;padding:8px;box-shadow:var(--shadow);z-index:100}.search-panel.open{display:block}.search-group{padding:7px 5px 3px;color:#ffe5a0;font-weight:950}.result{width:100%;text-align:left;background:#0e2637;border:1px solid #294a60;color:var(--text);border-radius:10px;padding:9px 10px;margin:5px 0;cursor:pointer}.result:hover{background:#143246;border-color:#5c958a}.rtitle{font-weight:900}.rsnip{color:#b7cad6;font-size:.76rem;margin-top:3px}mark{background:#655a22;color:#fff1aa;border-radius:3px;padding:0 2px}
.mobilemods{display:none}
@media(max-width:820px){.layout{grid-template-columns:1fr}.sidebar{display:none}.mobilemods{display:flex;overflow:auto;gap:6px;padding:7px;background:#071521;border-bottom:1px solid var(--line);position:sticky;top:50px;z-index:40}.mobilemods button{flex:0 0 auto;border:1px solid var(--line);border-radius:999px;background:#0d2131;color:var(--text);padding:7px 9px;font-weight:900}.mobilemods button.active{border-color:#63aa9e;background:#153849}.current{display:none}.searchbox{width:100%;max-width:none;margin:0}.search-panel{right:8px;width:calc(100vw - 16px)}#homeView{padding:24px 13px 45px}}
</style>
